DATABASE_URL=postgresql://chat_ro:chat_ro_pass@localhost:5432/statements
DATABASE_URL_MIGRATE=postgresql://chat_rw:chat_rw_pass@localhost:5432/statements

# Chat answers are the only feature that uses this key. Leave empty in git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini

# Required only when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional. Set locally so uploaded statements can flag transfers to your own other account.
# Do not commit a real UPI handle.
SELF_UPI_HINT=

SEED_CSV=../db/seed/transactions.csv
PORT=3000
